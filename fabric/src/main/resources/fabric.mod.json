{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modMyVersion}-fabric",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${modAuthor}"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "us.timinc.mc.timcore.fabric.TimCoreFabric"
      }
    ]
  },
  "depends": {
    "java": ">=21",
    "minecraft": "${minecraft_version}",
    "fabric": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin}"
  },
  "conflicts": {
    "cobblemon": "<${cobblemon_version}"
  },
  "contact": {
    "homepage": "${modDiscord}",
    "issues": "${modIssues}",
    "sources": "${modSource}"
  },
  "icon": "${modId}_small.png"
}
